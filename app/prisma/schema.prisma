generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senha        String
  role         String   @default("consultor") // admin | consultor
  status       String   @default("ativo")     // ativo | inativo
  avatar       String?
  dataCriacao  DateTime @default(now())
  ultimoAcesso DateTime?

  diagnosticos Diagnostico[]
}

model Diagnostico {
  id           String   @id @default(cuid())
  empresaNome  String
  empresaCidade String
  empresaEstado String
  status       String   @default("rascunho") // rascunho | completo
  dataCriacao  DateTime @default(now())

  criadoPorId  String
  criadoPor    User     @relation(fields: [criadoPorId], references: [id])

  // Dados comerciais (VGV, corretores)
  totalVGV              Float?   // VGV vendido nos últimos 12 meses
  vgvGoal               Float?   // Meta de VGV
  avgTicket             Float?   // Ticket médio
  totalBrokers          Int?     // Total de corretores na base
  activeBrokers         Int?     // Corretores que venderam (12m)

  // Novos campos
  shareHouse            Float?   // % VGV vendido pela House
  shareParcerias        Float?   // % VGV vendido pelo Canal de Parcerias
  numImobiliarias       Int?     // Número de imobiliárias parceiras
  segmentacao           String?  // "nao" | "nao_gostaria" | "sim_parcial" | "sim_total"
  segmentacaoDescritiva String?  // Texto livre (se Sim)
  relatoriosDesejados   String?  // JSON array de opções selecionadas
  relatoriosDescritivo  String?  // Texto livre
  tabelaZeroParcerias   Boolean? // Canal Parcerias tem acesso à Tabela Zero
  aiAnalysis            String?  // JSON resultado consolidado da IA
  isSimulacao           Boolean  @default(false) // true = dados de teste, ignorado no BI

  cargos              Cargo[]
  ferramentasGerais   FerramentaGeral[]
  problemasIdentificados ProblemaIdentificado[]
}

model Cargo {
  id              String  @id @default(cuid())
  cargoKey        String  // e.g. cargo_diretor_comercial
  nome            String
  existe          Boolean @default(true)
  acumulaFuncao   String?
  personalizado   Boolean @default(false)
  subordinadosDe  String? // cargoKey do superior

  // Novos campos
  quantidade             Int     @default(1) // Quantas pessoas neste cargo
  kpiPrincipal           String? // JSON array de KPIs
  atividadesDescritivas  String? // Texto livre descrevendo atividades
  crmNome                String? // Qual CRM (se selecionou CRM)

  diagnosticoId   String
  diagnostico     Diagnostico @relation(fields: [diagnosticoId], references: [id], onDelete: Cascade)

  tarefas         Tarefa[]
  metricas        Metrica[]
  ferramentas     Ferramenta[]
  subordinados    Subordinado[]
}

model Tarefa {
  id      String @id @default(cuid())
  nome    String
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
}

model Metrica {
  id      String @id @default(cuid())
  nome    String
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
}

model Ferramenta {
  id      String @id @default(cuid())
  nome    String
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
}

model Subordinado {
  id        String @id @default(cuid())
  cargoKey  String // cargoKey do subordinado
  cargoId   String
  cargo     Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
}

model FerramentaGeral {
  id              String @id @default(cuid())
  nome            String
  diagnosticoId   String
  diagnostico     Diagnostico @relation(fields: [diagnosticoId], references: [id], onDelete: Cascade)
}

model ProblemaIdentificado {
  id              String @id @default(cuid())
  descricao       String
  diagnosticoId   String
  diagnostico     Diagnostico @relation(fields: [diagnosticoId], references: [id], onDelete: Cascade)
}
